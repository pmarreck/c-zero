#!/usr/bin/env bash
# ./cg: input-growth gates: per-doubling CPU-time ratios of round-tripping 2048 to 16384 generated entries (single-core and 12-core cases),
# checked by performance-profile against this project's external history. Cases are in
# profiling.json; the adapter is tests/benchmark/c0_bench.zig. Extra arguments go to
# performance-profile (for example --case NAME). Run inside the dev shell: nix develop -c ./cg
# History goes to $PERFORMANCE_HISTORY_URL (default file://$HOME/.local/state/performance-history).
exec "$(dirname "${BASH_SOURCE[0]}")/tests/benchmark/engine" run --mode cg "$@"
