# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	bm = Fixed-workload round-trip CPU benchmarks via performance-profile
	cg = Input-growth CPU gates via performance-profile
	cli/codec_host.c = CLI plugin host: discovery, info parsing, codec detection, streamed process execution (POSIX and Windows)
	codecs = Real-world format codecs, each built as a c0-codec-<name> plugin executable
	codecs/c0_plugin.h = C ABI between a codec's Zig library and the plugin executable host
	codecs/plugin.zig = Plugin adapter: wraps a codec type in the c0_plugin.h C ABI and serializes info as c0-codec/1 metadata
	codecs/plugin_main.c = C host compiled into every c0-codec-<name>: argv parsing, stdin/stdout I/O, protocol c0-codec/1
	codecs/plugins = One root file per plugin executable, exporting its codec through the plugin ABI
	codecs/vendor = Vendored lz4 and zstd C sources (linked only by the bg3 plugin)
	docs/BENCHMARKS.md = Performance gate commands, workload, domain limitation and shape-bound rationale
	docs/PLAN_LOG.md = Retired PLAN.md items
	docs/plan_context/codec_plugins.md = Design and protocol contract for codecs as external plugins (c0-codec/1)
	docs/plan_context/smart_encoding_defect.md = Smart-encoding round-trip defect: evidence, pending owner decision, constraints
	mg = Peak-heap growth and residual gates via performance-profile
	profiling.json = performance-profile cases: round-trip CPU growth (1c/12c), peak heap, fixed 16384-entry CPU
	tests/benchmark/build-bench = Builds c0-bench in a given optimize mode under zig-out/bench/MODE
	tests/benchmark/c0_bench.zig = c0-bench adapter: seeded fixture generator, counting allocator, timed encode/decode round trip emitting performance-measurement/v1 JSON
	tests/benchmark/engine = Builds ReleaseFast c0-bench and runs performance-profile with profiling.json
	tests/benchmark/run = performance-profile adapter command: execs the ReleaseFast c0-bench
	tests/benchmark/test = Contract test for c0-bench: clean JSON, Debug refusal, malformed-argument rejection
	tests/cli/test_codecs.sh = Codec plugin host tests with Bash fake plugins, plus conformance and round trips of the bundled plugins
	tests/windows/remote-smoke = On-demand real-Windows plugin-host smoke test over SSH (cmd.exe, paths with spaces, digests vs native)
	tests/windows/smoke = Cross-builds for x86_64-windows and runs the plugin host under Wine against native outputs
]
